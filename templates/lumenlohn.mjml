<mjml>
  <mj-head>
    <mj-title>{{ subject | default("Comunicação Técnica Pericial") }}</mj-title>
    
    <mj-raw>
      <meta name="color-scheme" content="light dark">
      <meta name="supported-color-schemes" content="light dark">
    </mj-raw>

    <mj-attributes>
      <mj-all font-family="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif" color="#1e293b" />
      <mj-text font-size="15px" line-height="24px" />
      <mj-class name="mono" font-family="'Courier New', Courier, 'Lucida Console', monospace" />
    </mj-attributes>

    <!-- Estilos Estruturais e Dark Mode com Fallbacks -->
    <mj-style>
      :root {
        color-scheme: light dark;
        supported-color-schemes: light dark;
      }
      .paper-card {
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-top: 3px solid #1e3a8a;
        border-radius: 4px;
        overflow: hidden;
        width: 94% !important;
        max-width: 620px !important;
        margin: 0 auto !important;
      }
      .site-pill {
        color: #1e3a8a !important;
        text-decoration: none !important;
      }

      /* === MODO ESCURO === */
      @media (prefers-color-scheme: dark) {
        .page-body, body {
          background-color: #0f141c !important;
        }
        .paper-card {
          background-color: #161e2a !important;
          border-color: #263040 !important;
          border-top-color: #93c5fd !important;
        }
        .paper-card > table > tbody > tr > td {
          background-color: #161e2a !important;
        }

        /* Tipografia do Corpo no Escuro */
        .md-body, .md-body p, .md-body li, .md-body table td {
          color: #e2e8f0 !important;
        }
        .md-body strong, .md-body b {
          color: #f8fafc !important;
        }
        .md-body h1, .md-body h2, .md-body h3 {
          color: #93c5fd !important;
        }
        .md-body a {
          color: #93c5fd !important;
          border-bottom-color: #60a5fa !important;
        }
        .md-body hr {
          border-top-color: #263040 !important;
        }

        /* Metadados e Cabeçalho no Escuro */
        .header-meta div {
          color: #7dd3fc !important;
        }
        .header-title div {
          color: #f8fafc !important;
        }
        .header-sub div {
          color: #94a3b8 !important;
        }
        .site-pill {
          background-color: #1e293b !important;
          color: #93c5fd !important;
          border-color: #3b82f6 !important;
        }

        /* Código e Citações no Escuro */
        .md-body code {
          background-color: #1a2433 !important;
          color: #93c5fd !important;
          border-color: #263040 !important;
        }
        .md-body pre {
          background-color: #111827 !important;
          color: #cbd5e1 !important;
          border-color: #374151 !important;
        }
        .md-body blockquote {
          background-color: #1a2433 !important;
          color: #cbd5e1 !important;
          border-left-color: #93c5fd !important;
        }

        /* Tabelas no Escuro */
        .md-body table {
          border-color: #263040 !important;
        }
        .md-body th {
          background-color: #1a2433 !important;
          color: #93c5fd !important;
          border-bottom-color: #3b82f6 !important;
          border-right-color: #263040 !important;
        }
        .md-body td {
          border-bottom-color: #263040 !important;
          border-right-color: #263040 !important;
        }

        /* Assinatura e Rodapé no Escuro */
        .sig-block div {
          color: #cbd5e1 !important;
        }
        .sig-block strong {
          color: #f8fafc !important;
        }
        .footer-card, .footer-card > table > tbody > tr > td {
          background-color: #111827 !important;
          border-top-color: #263040 !important;
        }
        .footer-card div {
          color: #94a3b8 !important;
        }
      }
    </mj-style>

    <!-- === ESTILOS INLINE PARA CLIENTES LEGADOS / OUTLOOK === -->
    <mj-style inline="inline">
      .md-body p {
        margin: 0 0 14px 0;
        padding: 0;
      }
      .md-body strong, .md-body b {
        color: #0f172a;
        font-weight: 600;
      }
      .md-body del, .md-body s {
        color: #94a3b8;
        text-decoration: line-through;
      }
      .md-body h1, .md-body h2, .md-body h3 {
        color: #0f172a;
        margin: 22px 0 10px 0;
        line-height: 1.3;
      }
      .md-body h1 {
        font-size: 19px;
        font-weight: 700;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 6px;
      }
      .md-body h2 {
        font-size: 17px;
        font-weight: 600;
      }
      .md-body h3 {
        font-size: 15px;
        font-weight: 600;
        color: #1e3a8a;
      }
      
      .md-body ul, .md-body ol {
        margin: 0 0 14px 0;
        padding-left: 22px;
      }
      .md-body li {
        margin-bottom: 6px;
      }
      .md-body hr {
        border: 0;
        border-top: 1px solid #e2e8f0;
        margin: 22px 0;
      }
      .md-body a {
        color: #1e3a8a;
        text-decoration: none;
        border-bottom: 1px solid #93c5fd;
        font-weight: 500;
      }
      .md-body code {
        font-family: 'Courier New', Courier, monospace;
        font-size: 13px;
        background-color: #f1f5f9;
        color: #0f172a;
        padding: 2px 5px;
        border-radius: 3px;
        border: 1px solid #e2e8f0;
      }
      .md-body pre {
        font-family: 'Courier New', Courier, monospace;
        font-size: 13px;
        line-height: 18px;
        background-color: #f8fafc;
        color: #1e293b;
        padding: 12px;
        border-radius: 4px;
        border: 1px solid #e2e8f0;
        overflow-x: auto;
        white-space: pre-wrap;
        word-wrap: break-word;
        margin: 14px 0;
      }
      .md-body pre code {
        background-color: transparent;
        color: inherit;
        padding: 0;
        border: none;
      }
      .md-body blockquote {
        margin: 14px 0;
        padding: 10px 14px;
        border-left: 3px solid #1e3a8a;
        background-color: #f8fafc;
        color: #334155;
        border-radius: 0 4px 4px 0;
      }
      .md-body blockquote p {
        margin-bottom: 0;
      }
      .md-body table {
        width: 100%;
        border-collapse: collapse;
        margin: 16px 0;
        font-size: 14px;
        line-height: 20px;
        border: 1px solid #e2e8f0;
      }
      .md-body th {
        background-color: #f8fafc;
        color: #0f172a;
        font-weight: 600;
        text-align: left;
        padding: 8px 10px;
        border-bottom: 1px solid #cbd5e1;
        border-right: 1px solid #e2e8f0;
      }
      .md-body td {
        padding: 8px 10px;
        border-bottom: 1px solid #e2e8f0;
        border-right: 1px solid #e2e8f0;
        color: #1e293b;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#fafaf8" css-class="page-body" width="640px">
    <mj-spacer height="20px" />

    <mj-wrapper css-class="paper-card" padding="0px">

      <!-- Linha Acima do Cabeçalho: Acento Azul Marinho Pericial -->
      <mj-raw>
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="line-height:0; font-size:0;">
          <tr>
            <td height="3" bgcolor="#1e3a8a" style="background-image: linear-gradient(#1e3a8a, #1e3a8a);"></td>
          </tr>
        </table>
      </mj-raw>

      <!-- Cabeçalho Institucional -->
      <mj-section padding="20px 24px 12px 24px">
        <mj-group vertical-align="middle">
          <mj-column width="75%" vertical-align="middle">
            <mj-text css-class="header-meta" mj-class="mono" align="left" font-size="11px" font-weight="600" color="#0f4c5c" letter-spacing="0.06em" padding="0px 0px 4px 0px">
              PERÍCIA • COMPLIANCE • CONTRATOS • MEDIAÇÃO DE TI
            </mj-text>
            <mj-text css-class="header-title" align="left" font-size="18px" font-weight="700" color="#0f172a" line-height="22px" padding="0px 0px 4px 0px">
              Lumen Müller Lohn Freitas
            </mj-text>
            <mj-text css-class="header-sub" align="left" font-size="12px" font-weight="500" color="#475569" line-height="16px" padding="0px">
              Bacharela em Direito • Especialista em Redes de Computadores • Consultoria Técnica B2B
            </mj-text>
          </mj-column>
          <mj-column width="25%" vertical-align="middle">
            <mj-text align="right" font-size="11px" font-weight="600" padding="0px">
              <a href="https://lumenlohn.com.br" class="site-pill" style="background-color: #f1f5f9; color: #1e3a8a; border: 1px solid #cbd5e1; border-radius: 4px; padding: 4px 8px; text-decoration: none; display: inline-block; font-family: 'Courier New', Courier, monospace;">
                lumenlohn.com.br ↗
              </a>
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>

      <!-- Divisória Elegante -->
      <mj-section padding="0px">
        <mj-column>
          <mj-divider border-width="1px" border-style="solid" border-color="#e2e8f0" padding="4px 24px 8px 24px" />
        </mj-column>
      </mj-section>

      <!-- Corpo da Mensagem (Injeção de {{ content_html }}) -->
      <mj-section padding="8px 24px 16px 24px">
        <mj-column>
          <mj-text>
            <div class="md-body">
              {{ content_html }}
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Divisória Pré-Assinatura -->
      <mj-section padding="0px">
        <mj-column>
          <mj-divider border-width="1px" border-style="solid" border-color="#e2e8f0" padding="8px 24px" />
        </mj-column>
      </mj-section>

      <!-- Assinatura Técnico-Jurídica Formal -->
      <mj-section padding="0px 24px 20px 24px">
        <mj-column>
          <mj-text css-class="sig-block" align="left" font-size="13px" line-height="20px" color="#334155" padding="0px">
            Atenciosamente,<br/><br/>
            <strong style="color: #0f172a; font-size: 14px;">Lumen Müller Lohn Freitas</strong><br/>
            Bacharela em Direito • Especialista em Redes de Computadores<br/>
            Assistência Técnica Judicial &amp; Consultoria Pré-Processual<br/>
            <span style="font-family: 'Courier New', Courier, monospace; font-size: 12px; color: #475569;">E-mail: pericia@lumenlohn.com.br | Contato: (48) 99812-0812</span>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Rodapé Institucional -->
      <mj-section css-class="footer-card" padding="12px 24px" background-color="#f8fafc" border-top="1px solid #e2e8f0">
        <mj-column>
          <mj-text align="center" font-size="11px" line-height="16px" color="#64748b" padding="0px">
            Lumen Müller Lohn Freitas — Perícia, Compliance e Mediação de TI<br/>
            Atendimento direto a advogados, departamentos jurídicos e magistrados • Grande Florianópolis/SC e atuação remota nacional<br/>
            <span style="font-size: 10px; color: #94a3b8;">Comunicação restrita e confidencial resguardada pelo sigilo profissional.</span>
          </mj-text>
        </mj-column>
      </mj-section>

    </mj-wrapper>
    <mj-spacer height="20px" />
  </mj-body>
</mjml>
